<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.dupelens</groupId>
  <artifactId>dupelens</artifactId>
  <version>1.2.1</version>
  <name>DupeLens</name>
  <description>Read-only duplicate discovery and local browser review with confirmed Trash actions.</description>
  <url>https://github.com/illusionoftalha/dupelens</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>illusionoftalha</id>
      <url>https://github.com/illusionoftalha</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/illusionoftalha/dupelens.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/illusionoftalha/dupelens.git</developerConnection>
    <url>https://github.com/illusionoftalha/dupelens</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/illusionoftalha/dupelens/issues</url>
  </issueManagement>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <skipTests>false</skipTests>
  </properties>
  <build>
    <finalName>dupelens</finalName>
    <plugins>
      <!-- The dependency-free suites expose main methods, not JUnit tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration><skipTests>true</skipTests></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <classpathScope>test</classpathScope>
          <skip>${skipTests}</skip>
          <timeout>120000</timeout>
        </configuration>
        <executions>
          <execution>
            <id>scanner-integration-tests</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <arguments>
                <argument>-cp</argument><classpath/>
                <argument>dev.dupelens.SmokeTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>review-safety-tests</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <arguments>
                <argument>-Djdk.net.unixdomain.tmpdir=${project.build.directory}</argument>
                <argument>-cp</argument><classpath/>
                <argument>dev.dupelens.ReviewTest</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.dupelens.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
        <executions>
          <execution>
            <id>default-jar</id>
            <configuration>
              <includes>
                <include>dev/dupelens/Main*.class</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>review-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>review</classifier>
              <archive>
                <manifest>
                  <mainClass>dev.dupelens.Review</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
